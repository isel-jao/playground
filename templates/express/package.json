{
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "clean": "rm -rf dist node_modules && git clean -fdx",
    "fclean": "pnpm clean && rm -rf package-lock.json pnpm-lock.yaml",
    "predev": "test -f .env || cp .env.example .env",
    "dev": "tsx --watch --env-file=.env src/main.ts",
    "start": "node dist/main.js",
    "build": "pnpm tsc",
    "test": "vitest run "
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
